HUMBEE_SFA_PROFILE=local

HUMBEE_SFA_JWT_SECRET=<openssl rand -base64 32>
HUMBEE_SFA_PHONE_HMAC_SECRET=<openssl rand -base64 32>
HUMBEE_SFA_PHONE_ENC_KEY=<Fernet key>

HUMBEE_SFA_DB_USER=postgres
HUMBEE_SFA_DB_PASSWORD=postgres

HUMBEE_API_KEY=<Humbee API key>

HUMBEE_SFA_OTP_SMS_USERNAME=
HUMBEE_SFA_OTP_SMS_API_KEY=

# Optional: one phone whose OTP is always the fixed code (prd included). Set both or neither.
HUMBEE_SFA_OTP_FIXED_CODE_PHONE_E164=
HUMBEE_SFA_OTP_FIXED_CODE=
