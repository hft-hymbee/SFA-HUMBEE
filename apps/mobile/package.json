{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor native shell for Humbee SFA. Contains no application code — wraps the static export from apps/web.",
  "scripts": {
    "sync": "cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "doctor": "cap doctor",
    "apk:local": "bash scripts/build-android.sh local debug",
    "apk:qa": "bash scripts/build-android.sh qa debug",
    "apk:qa:release": "bash scripts/build-android.sh qa release",
    "apk:prod": "bash scripts/build-android.sh prod debug",
    "apk:prod:release": "bash scripts/build-android.sh prod release",
    "ios:sim:local": "bash scripts/run-ios-sim.sh local",
    "ios:sim:qa": "bash scripts/run-ios-sim.sh qa",
    "ios:sim:prod": "bash scripts/run-ios-sim.sh prod",
    "ipa:qa": "bash scripts/build-ios.sh qa testflight",
    "ipa:qa:file": "bash scripts/build-ios.sh qa ipa",
    "ipa:prod": "bash scripts/build-ios.sh prod testflight",
    "ipa:prod:file": "bash scripts/build-ios.sh prod ipa"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
