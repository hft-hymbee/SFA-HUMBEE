{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "packages/humbee-design-system/src/core/**",
              "packages/humbee-design-system/src/feedback/**",
              "packages/humbee-design-system/src/forms/**",
              "packages/humbee-design-system/src/layout/**",
              "packages/humbee-design-system/src/mobile/**",
              "packages/humbee-design-system/src/navigation/**",
              "ui_kits/humbee-app/**",
              "ui_kits/humbee-sfa/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color \u2014 use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value \u2014 use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Lato))/i]",
        "message": "Font not provided by the design system. Available: Lato."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopAppBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|onBack|onBell|bellCount|action|variant|style|key|ref|className|style|children)$/]",
        "message": "<TopAppBar> doesn't accept that prop. Declared props: title, onBack, onBell, bellCount, action, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApprovalStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|detail|time|state|key|ref|className|style|children)$/]",
        "message": "<ApprovalStep> doesn't accept that prop. Declared props: label, detail, time, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='ApprovalStep'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:done|edited|rejected|pending|current|future)$/]",
        "message": "<ApprovalStep> state must be one of 'done' | 'edited' | 'rejected' | 'pending' | 'current' | 'future'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:badgeText|badgeType|badgePosition|badgeSize|style|key|ref|className|style|children)$/]",
